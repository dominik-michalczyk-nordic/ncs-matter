# SDK sync configuration for .github/workflows/sdk-sync.yml

# Manifest projects to bump. Names must match west.yml project names.
SDK_SYNC_PROJECTS=nrf,matter

# Project to sync from.
# repo: repository on GitHub
# branch: branch of the project to sync from
# rebase: whether to rebase the project to the main branch
#         This option can be used only if the branch is not the main branch and the base argument
#         is provided.
# base: base branch to rebase to. This argument is required if the rebase argument is true.
SDK_SYNC_PROJECT_nrf=repo=nrfconnect/sdk-nrf branch=main rebase=false
SDK_SYNC_PROJECT_matter=repo=nrfconnect/sdk-connectedhomeip branch=ncs-sync rebase=true base=master

# Twister sample under the add-on repository (relative path).
# These samples are used to verify if the add-on is working correctly.
# SDK_SYNC_TWISTER_PATH: path to the sample directory within the add-on repository
# SDK_SYNC_TWISTER_SCENARIO: scenario to run for the sample. It must be consistent with an entry
#                            in the sample.yaml file.
# SDK_SYNC_TWISTER_ALL: whether to run all boards for the sample or only the board targets
#                       specified in the integration scenario.
SDK_SYNC_TWISTER_PATH=samples/template
SDK_SYNC_TWISTER_SCENARIO=sample.matter.template.debug
SDK_SYNC_TWISTER_ALL=true

# Optional pip requirements to install after west update (comma-separated paths relative to the
# west workspace root, not the manifest repository directory).
SDK_SYNC_PIP_REQUIREMENTS=nrf/scripts/requirements-extra.txt,modules/lib/matter/scripts/setup/requirements.nrfconnect.txt

# Branch configuration for the add-on
# SDK_SYNC_MAIN_BRANCH: main branch of the add-on repository
# SDK_SYNC_INTEGRATION_BRANCH: Branch for storing the integration of the add-on with the synchronized projects
# SDK_SYNC_PR_BRANCH: PR name for the synchronization purposes.
# SDK_SYNC_PR_LABEL: Additional labels that can be set in the synchronization PR.
SDK_SYNC_MAIN_BRANCH=main
SDK_SYNC_INTEGRATION_BRANCH=ncs-sync
SDK_SYNC_PR_BRANCH=sdk-sync/test
SDK_SYNC_PR_LABEL=ci-disabled

# Manifest and pull request text.
SDK_SYNC_MANIFEST_COMMIT_PREFIX=manifest: Bump manifest revisions for weekly sync
SDK_SYNC_PR_TITLE=manifest: Weekly manifest sync test
